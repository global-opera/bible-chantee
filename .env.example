# Bible Chantée - Variables d'environnement
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# Google Analytics 4 Property ID (ID numérique de votre propriété GA4)
# Exemple: 123456789
# Où le trouver: GA4 > Admin > Paramètres de la propriété
GA4_PROPERTY_ID=

# Google Service Account JSON (contenu complet du fichier JSON)
# IMPORTANT: Sur une seule ligne, échapper les guillemets si nécessaire
# Exemple: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# Où le trouver: Fichier JSON téléchargé depuis Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_JSON=

# Supabase (si utilisé)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# NOTE: Le fichier .env est ignoré par git (.gitignore)
# Ne JAMAIS committer les credentials !
