;/* BC_CHAPTER_LABELS_AUTOLOAD_BOOKNAMES_V1 */
(function(){
  function __bcEnsureBookNames(cb){
    try{
      if (window.BOOK_NAMES) { cb(); return; }
      var s = document.createElement('script');
      s.src = '=' + Date.now();
      s.onload = cb;
      s.onerror = cb;
      document.head.appendChild(s);
    } catch(e){ cb(); }
  }
  var __oldRelabel = (typeof relabel === 'function') ? relabel : null;
  if (__oldRelabel){
    relabel = function(){ __bcEnsureBookNames(function(){ try{ __oldRelabel(); }catch(e){} }); };
  } else {
    __bcEnsureBookNames(function(){});
  }
})();
/* BC_CHAPTER_LABELS_FORCE_V2 */
(function(){
  try { console.log("[chapter-labels] loaded"); } catch(e){}

  function relabel(){
    try {
      var lang = "FR";
      try {
        if (window.BC_LANG && window.BC_LANG.current) lang = window.BC_LANG.current;
        else {
          var u = new URL(location.href);
          var q = (u.searchParams.get("lang") || "FR").toUpperCase();
          lang = q;
        }
      } catch(e){}

      var bookCode = "";
      try {
        if (window.BC_STATE && window.BC_STATE.bookCode) bookCode = window.BC_STATE.bookCode;
        if (!bookCode && window.currentBookCode) bookCode = window.currentBookCode;
        if (!bookCode && window.bookCode) bookCode = window.bookCode;
      } catch(e){}

      if (!bookCode) {
        try {
          var a = document.querySelector("audio");
          if (a && a.src) {
            var m = a.src.match(/(\d{2}_[A-Z0-9]{3})/);
            if (m) bookCode = m[1];
          }
        } catch(e){}
      }

      var bookName = bookCode || "Livre";
      try {
        if (window.BOOK_NAMES && window.BOOK_NAMES[lang] && window.BOOK_NAMES[lang][bookCode]) bookName = window.BOOK_NAMES[lang][bookCode];
        else if (window.BOOK_NAMES && window.BOOK_NAMES.FR && window.BOOK_NAMES.FR[bookCode]) bookName = window.BOOK_NAMES.FR[bookCode];
      } catch(e){}

      var sels = document.querySelectorAll("select");
      for (var s=0; s<sels.length; s++){
        var sel = sels[s];
        if (!sel || !sel.options || sel.options.length < 2) continue;

        // heuristique: options type "01 - 01"
        var t0 = (sel.options[0].textContent || "").trim();
        if (!/^\d{1,3}\s*-\s*\d{1,3}$/.test(t0) && !/^\d{1,3}$/.test(t0)) continue;

        for (var i=0; i<sel.options.length; i++){
          var opt = sel.options[i];
          var txt = (opt.textContent || "").trim();
          var ch = i + 1;

          var m1 = txt.match(/^\d{1,3}\s*-\s*(\d{1,3})$/);
          if (m1) ch = parseInt(m1[1],10);
          else if (/^\d{1,3}$/.test(txt)) ch = parseInt(txt,10);
          else if (opt.value && /^\d{1,3}$/.test(String(opt.value))) ch = parseInt(opt.value,10);

          opt.textContent = bookName + " – Chapitre " + ch;
        }
      }
    } catch(e){
      try { console.error("[chapter-labels] error", e); } catch(x){}
    }
  }

  relabel();
  setTimeout(relabel, 300);
  setTimeout(relabel, 1200);

  try {
    var obs = new MutationObserver(function(){ relabel(); });
    obs.observe(document.documentElement, {subtree:true, childList:true});
  } catch(e){}
})();

