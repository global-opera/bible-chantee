function __bcInferBookCodeFromIndex() {
  // Mapping officiel Bible Chantée
  var map = {
    "01":"01_GEN","02":"02_EXO","03":"03_LEV","04":"04_NUM","05":"05_DEU",
    "06":"06_JOS","07":"07_JDG","08":"08_RUT","09":"09_1SA","10":"10_2SA",
    "11":"11_1KI","12":"12_2KI","13":"13_1CH","14":"14_2CH","15":"15_EZR",
    "16":"16_NEH","17":"17_EST","18":"18_JOB","19":"19_PSA","20":"20_PRO",
    "21":"21_ECC","22":"22_SNG","23":"23_ISA","24":"24_JER","25":"25_LAM",
    "26":"26_EZK","27":"27_DAN","28":"28_HOS","29":"29_JOL","30":"30_AMO",
    "31":"31_OBA","32":"32_JON","33":"33_MIC","34":"34_NAM","35":"35_HAB",
    "36":"36_ZEP","37":"37_HAG","38":"38_ZEC","39":"39_MAL",
    "40":"40_MAT","41":"41_MRK","42":"42_LUK","43":"43_JHN","44":"44_ACT",
    "45":"45_ROM","46":"46_1CO","47":"47_2CO","48":"48_GAL","49":"49_EPH",
    "50":"50_PHP","51":"51_COL","52":"52_1TH","53":"53_2TH",
    "54":"54_1TI","55":"55_2TI","56":"56_TIT","57":"57_PHM",
    "58":"58_HEB","59":"59_JAS","60":"60_1PE","61":"61_2PE",
    "62":"62_1JN","63":"63_2JN","64":"64_3JN","65":"65_JUD","66":"66_REV"
  };

  // Cherche "01" dans le header "01 — Chapitre X"
  var h = document.querySelector("h1,h2,.header-title,.lecteur-title");
  if (h) {
    var m = h.textContent.match(/\\b(\\d{2})\\b/);
    if (m && map[m[1]]) return map[m[1]];
  }
  return "";
}
;/* BC_CHAPTER_LABELS_AUTOLOAD_BOOKNAMES_V1 */
(function(){
  function __bcEnsureBookNames(cb){
    try{
      if (window.BOOK_NAMES) { cb(); return; }
      var s = document.createElement('script');
      s.src = '=' + Date.now();
      s.onload = cb;
      s.onerror = cb;
      document.head.appendChild(s);
    } catch(e){ cb(); }
  }
  var __oldRelabel = (typeof relabel === 'function') ? relabel : null;
  if (__oldRelabel){
    relabel = function(){ __bcEnsureBookNames(function(){ try{ __oldRelabel(); }catch(e){} }); };
  } else {
    __bcEnsureBookNames(function(){});
  }
})();
/* BC_CHAPTER_LABELS_FORCE_V2 */
(function(){
  try { console.log("[chapter-labels] loaded"); } catch(e){}

  function relabel(){
    try {
      var lang = "FR";
      try {
        if (window.BC_LANG && window.BC_LANG.current) lang = window.BC_LANG.current;
        else {
          var u = new URL(location.href);
          var q = (u.searchParams.get("lang") || "FR").toUpperCase();
          lang = q;
        }
      } catch(e){}

      var bookCode = __bcInferBookCodeFromIndex();
      try {
        if (window.BC_STATE && window.BC_STATE.bookCode) bookCode = window.BC_STATE.bookCode;
        if (!bookCode && window.currentBookCode) bookCode = window.currentBookCode;
        if (!bookCode && window.bookCode) bookCode = window.bookCode;
      } catch(e){}

      if (!bookCode) {
        try {
          var a = document.querySelector("audio");
          if (a && a.src) {
            var m = a.src.match(/(\d{2}_[A-Z0-9]{3})/);
            if (m) bookCode = m[1];
          }
        } catch(e){}
      }

      var bookName = "Livre";
try {
  if (window.BOOK_NAMES && window.BOOK_NAMES[lang] && window.BOOK_NAMES[lang][bookCode]) {
    bookName = window.BOOK_NAMES[lang][bookCode];
  } else if (window.BOOK_NAMES && window.BOOK_NAMES.FR && window.BOOK_NAMES.FR[bookCode]) {
    bookName = window.BOOK_NAMES.FR[bookCode];
  } else if (bookCode && /^\\d{2}_[A-Z0-9]{3}$/.test(bookCode)) {
    // Nettoyage ultime du code (01_GEN → GEN → Genèse si possible)
    var k = bookCode.replace(/^\\d{2}_/, "");
    var map = { GEN:"Genèse", EXO:"Exode", LEV:"Lévitique", NUM:"Nombres", DEU:"Deutéronome" };
    if (map[k]) bookName = map[k];
  }
} catch(e){}
      try {
        if (window.BOOK_NAMES && window.BOOK_NAMES[lang] && window.BOOK_NAMES[lang][bookCode]) bookName = window.BOOK_NAMES[lang][bookCode];
        else if (window.BOOK_NAMES && window.BOOK_NAMES.FR && window.BOOK_NAMES.FR[bookCode]) bookName = window.BOOK_NAMES.FR[bookCode];
      } catch(e){}

      var sels = document.querySelectorAll("select");
      for (var s=0; s<sels.length; s++){
        var sel = sels[s];
        if (!sel || !sel.options || sel.options.length < 2) continue;

        // heuristique: options type "01 - 01"
        var t0 = (sel.options[0].textContent || "").trim();
        if (!/^\d{1,3}\s*-\s*\d{1,3}$/.test(t0) && !/^\d{1,3}$/.test(t0)) continue;

        for (var i=0; i<sel.options.length; i++){
          var opt = sel.options[i];
          var txt = (opt.textContent || "").trim();
          var ch = i + 1;

          var m1 = txt.match(/^\d{1,3}\s*-\s*(\d{1,3})$/);
          if (m1) ch = parseInt(m1[1],10);
          else if (/^\d{1,3}$/.test(txt)) ch = parseInt(txt,10);
          else if (opt.value && /^\d{1,3}$/.test(String(opt.value))) ch = parseInt(opt.value,10);

          opt.textContent = bookName + " – Chapitre " + ch;
        }
      }
    } catch(e){
      try { console.error("[chapter-labels] error", e); } catch(x){}
    }
  }

  relabel();
  setTimeout(relabel, 300);
  setTimeout(relabel, 1200);

  try {
    var obs = new MutationObserver(function(){ relabel(); });
    obs.observe(document.documentElement, {subtree:true, childList:true});
  } catch(e){}
})();



